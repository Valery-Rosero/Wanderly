-- Create table if it does not exist (linked to auth.users)
CREATE TABLE IF NOT EXISTS public.usuarios (
  id UUID PRIMARY KEY,
  email TEXT,
  nombre TEXT,
  foto_profile TEXT,
  city TEXT,
  created_at TIMESTAMPTZ DEFAULT now()
);

-- If column creado_en exists (legacy), rename it to created_at
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'usuarios' AND column_name = 'creado_en'
  ) THEN
    -- only rename if created_at doesn't already exist
    IF NOT EXISTS (
      SELECT 1 FROM information_schema.columns
      WHERE table_schema = 'public' AND table_name = 'usuarios' AND column_name = 'created_at'
    ) THEN
      ALTER TABLE public.usuarios RENAME COLUMN creado_en TO created_at;
    END IF;
  END IF;
END;
$$ LANGUAGE plpgsql;

-- Add missing columns if table pre-exists and they aren't present
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'usuarios' AND column_name = 'foto_profile'
  ) THEN
    ALTER TABLE public.usuarios ADD COLUMN foto_profile TEXT;
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'usuarios' AND column_name = 'city'
  ) THEN
    ALTER TABLE public.usuarios ADD COLUMN city TEXT;
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'usuarios' AND column_name = 'created_at'
  ) THEN
    ALTER TABLE public.usuarios ADD COLUMN created_at TIMESTAMPTZ DEFAULT now();
  END IF;
END;
$$ LANGUAGE plpgsql;

-- Ensure unique index on email (if desired)
CREATE UNIQUE INDEX IF NOT EXISTS usuarios_email_uidx ON public.usuarios (email);

-- Enable Row Level Security on usuarios
ALTER TABLE public.usuarios ENABLE ROW LEVEL SECURITY;

-- Policies for usuarios (drop then create to ensure expected state)
DROP POLICY IF EXISTS "usuarios_select_own" ON public.usuarios;
DROP POLICY IF EXISTS "usuarios_insert_own" ON public.usuarios;
DROP POLICY IF EXISTS "usuarios_update_own" ON public.usuarios;
DROP POLICY IF EXISTS "usuarios_delete_own" ON public.usuarios;

CREATE POLICY "usuarios_select_own"
  ON public.usuarios
  FOR SELECT
  USING (auth.uid() = id);

CREATE POLICY "usuarios_insert_own"
  ON public.usuarios
