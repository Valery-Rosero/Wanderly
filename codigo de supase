-- ============================================================
-- 7) Function: obtener_lugares_cercanos (using geography & ST_DWithin)
-- ============================================================

CREATE OR REPLACE FUNCTION public.obtener_lugares_cercanos(
  user_lat DOUBLE PRECISION,
  user_lng DOUBLE PRECISION,
  radio_km INTEGER DEFAULT 10,
  filtro_tipo TEXT DEFAULT NULL
)
RETURNS TABLE (
  lugar_id UUID,
  nombre_lugar TEXT,
  direccion_lugar TEXT,
  tipo_lugar TEXT,
  distancia_km DOUBLE PRECISION
) AS $$
BEGIN
  RETURN QUERY
  SELECT
    lf.id,
    lf.nombre_lugar,
    lf.direccion,
    lf.tipo_lugar,
    ST_Distance(
      lf.coordenadas::geography,
      ST_SetSRID(ST_MakePoint(user_lng, user_lat), 4326)::geography
    ) / 1000 AS distancia_km
  FROM public.lugares_favoritos lf
  WHERE ST_DWithin(
    lf.coordenadas::geography,
    ST_SetSRID(ST_MakePoint(user_lng, user_lat), 4326)::geography,
    radio_km * 1000
  )
  AND (filtro_tipo IS NULL OR lf.tipo_lugar = filtro_tipo)
  ORDER BY distancia_km ASC;
END;
$$ LANGUAGE plpgsql STABLE;

