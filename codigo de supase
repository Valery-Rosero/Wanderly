-- 8) Trigger to set updated_at automatically
-- ============================================================

CREATE OR REPLACE FUNCTION public.set_updated_at()
RETURNS trigger AS $$
BEGIN
  NEW.updated_at := now();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Attach trigger to lugares_favoritos if not already present
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_trigger t
    JOIN pg_class c ON t.tgrelid = c.oid
    WHERE t.tgname = 'actualizar_lugares_updated_at' AND c.relname = 'lugares_favoritos'
  ) THEN
    DROP TRIGGER IF EXISTS actualizar_lugares_updated_at ON public.lugares_favoritos;
    CREATE TRIGGER actualizar_lugares_updated_at
      BEFORE UPDATE ON public.lugares_favoritos
      FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();
  END IF;
END;
$$ LANGUAGE plpgsql;

-- Attach a similar trigger for usuarios.updated_at if the column exists
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'usuarios' AND column_name = 'updated_at'
  ) THEN
    IF NOT EXISTS (
      SELECT 1 FROM pg_trigger t
      JOIN pg_class c ON t.tgrelid = c.oid
      WHERE t.tgname = 'set_updated_at_usuarios' AND c.relname = 'usuarios'
    ) THEN
      DROP TRIGGER IF EXISTS set_updated_at_usuarios ON public.usuarios;
      CREATE TRIGGER set_updated_at_usuarios
        BEFORE UPDATE ON public.usuarios
        FOR EACH ROW
        EXECUTE PROCEDURE public.set_updated_at();
    END IF;
  END IF;
END;
$$ LANGUAGE plpgsql;

