-- 9) Final notes: ensure constraints and hints for supabase
-- ============================================================

-- If you want the usuarios.id to reference auth.users (recommended), add FK:
-- But only add if auth.users exists and usuarios.id is UUID (non-destructive check)
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c WHERE c.relname = 'users' AND c.relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = 'auth'))
     AND EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='usuarios' AND column_name='id')
  THEN
    -- Add FK if not present
    IF NOT EXISTS (
      SELECT 1 FROM pg_constraint con
      JOIN pg_class rel ON rel.oid = con.conrelid
      WHERE rel.relname = 'usuarios' AND con.contype = 'f'
    ) THEN
      ALTER TABLE public.usuarios
      ADD CONSTRAINT fk_usuarios_auth_users FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE;
    END IF;
  END IF;
END;
$$ LANGUAGE plpgsql;

